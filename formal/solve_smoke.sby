# Fast sanity check for formal/solve_top.sv wiring (does it parse/flatten/prep and run a
# few BMC steps at all?) before committing to the full depth-135 search in solve.sby.
# Not part of the actual route-B search result.
[options]
mode cover
depth 6

[engines]
smtbmc yices

[script]
read_liberty -ignore_miss_func sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog puzzle.v
read_verilog -formal solve_top.sv
delete */t:sky130_fd_sc_hd__tapvpwrvgnd_1 */t:sky130_fd_sc_hd__decap_* */t:sky130_fd_sc_hd__fill_* */t:sky130_fd_sc_hd__diode_*
hierarchy -check -top solve_top
flatten
prep -top solve_top

[files]
pdk/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
out/solve_b/puzzle.v
formal/solve_top.sv
